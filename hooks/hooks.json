{
  "description": "Reminds Claude at the start of each Claude Code or Cowork session that the Craft logbook is installed",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
